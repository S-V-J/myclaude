# MyClaude Environment Configuration
# Get your NVIDIA API keys at https://build.nvidia.com

# Required — Primary NVIDIA NIM key (used for Nemotron 3 Ultra / Opus / Default)
NVIDIA_API_KEY_PROJECT_1="nvapi-..."

# Optional — Separate key for Nemotron 3 Ultra / Sonnet (load isolation)
# If not set, falls back to NVIDIA_API_KEY_PROJECT_1
NVIDIA_API_KEY_PROJECT_2=""

# Optional — Separate key for Nemotron 3 Ultra / Sonnet 1M (load isolation)
# If not set, falls back to NVIDIA_API_KEY_PROJECT_1
NVIDIA_API_KEY_PROJECT_3=""

# Optional — Separate key for Nemotron 3 Ultra / Haiku (load isolation)
# If not set, falls back to NVIDIA_API_KEY_PROJECT_1
NVIDIA_API_KEY_PROJECT_4=""

# Local proxy authentication key — used by Claude Code to talk to this proxy
# Auto-generated during installation
LITELLM_MASTER_KEY="sk-local-proxy-key"

# Force LiteLLM to use the standard chat/completions route for Anthropic messages
LITELLM_USE_CHAT_COMPLETIONS_URL_FOR_ANTHROPIC_MESSAGES="true"

# On-demand configuration
# Idle timeout in seconds before stopping backend (default: 300 = 5 minutes)
# Set to 0 to disable idle shutdown (always-on mode)
MYCLAUDE_IDLE_TIMEOUT=300