# MyClaude Environment Configuration
# Get your NVIDIA API key at https://build.nvidia.com
NVIDIA_API_KEY="PASTE_YOUR_NVIDIA_API_KEY_HERE"

# Optional: StepFun API key for stepfun-ai models (via NVIDIA NIM)
# Leave empty to reuse the NVIDIA key for both model families
STEPFUN_API_KEY=""

# Local proxy authentication key — used by Claude Code to talk to this proxy
LITELLM_MASTER_KEY="sk-local-proxy-key"

# Force LiteLLM to use the standard chat/completions route for Anthropic messages
LITELLM_USE_CHAT_COMPLETIONS_URL_FOR_ANTHROPIC_MESSAGES="true"
