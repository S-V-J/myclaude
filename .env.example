# MyClaude Environment Configuration
# Ports are dynamically assigned by myclaude.sh to avoid conflicts.
# Copy this file to .env and replace the placeholder values with your actual keys

# NVIDIA API Keys (Get from https://build.nvidia.com/)
NVIDIA_API_KEY_1="nvapi-your-first-key-here"
NVIDIA_API_KEY_2="nvapi-your-second-key-here"
NVIDIA_API_KEY_3="nvapi-your-third-key-here"
NVIDIA_API_KEY_4="nvapi-your-fourth-key-here"
NVIDIA_API_KEY_5="nvapi-your-fifth-key-here"
NVIDIA_API_KEY_6="nvapi-your-sixth-key-here"   # REQUIRED: all 6 keys are referenced by
                                               # config.yaml (74 deployments, 12/key x 6)
                                               # and myclaude.sh aborts if any is missing.

# LiteLLM Master Key (for securing the LiteLLM proxy)
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY="sk-local-your-master-key-here"

# Legacy / inert: set in config_base.yaml (litellm_settings), NOT read from env.
LITELLM_USE_CHAT_COMPLETIONS_URL_FOR_ANTHROPIC_MESSAGES="true"

# Inert: only the retired /usr/local/bin/myclaude launcher read this. The current
# myclaude.sh has no idle monitor. Harmless to leave; does nothing.
IDLE_TIMEOUT="0"